# Input column maps use analysis names on the left and source names on the right.
# Paths are relative to the repository unless absolute paths are supplied.
config <- list(
  input_mode = "shared",
  shared = list(cross_sectional = "data_raw/cross_sectional.csv",
                longitudinal = "data_raw/longitudinal.csv"),
  raw = list(
    surveys = data.frame(file = c("data_raw/survey_2023.xlsx", "data_raw/survey_2024.xlsx"),
                         sheet = c("Sheet3", "Sheet2"), year = c(2023L, 2024L)),
    followups = data.frame(file = c("data_raw/followup_batch1.xlsx", "data_raw/followup_batch2.xlsx", "data_raw/followup_batch3.xlsx"),
                           sheet = rep("Sheet1", 3)),
    baseline_times = data.frame(file = rep("data_raw/baseline_times.xlsx", 2),
                                sheet = c("Sheet1", "Sheet2")),
    baseline_year = 2023L, followup_year = 2024L, timezone = "Asia/Shanghai",
    id_column = "学号", timestamp_column = "提交答卷时间",
    time_id_column = "participant_id", time_column = "timestamp",
    minimum_id_length = 6L,
    network_batch_rule = "earliest",
    analysis_order_seed = 20260804L, retest_order_seed = 20260912L,
    columns = c(sex_code = "性别", age_years = "年龄", bmi_kg_m2 = "BMI",
                grade_code = "年级", major_code = "专业", hukou_code = "户籍",
                father_education_code = "父亲教育程度", mother_education_code = "母亲教育程度",
                only_child_code = "独生子女（1独生2非独生）",
                ipaq_total_met_min_week = "IPAQ_Total", ipaq_category_code = "IPAQ_Category (Recoded)"),
    gad_columns = paste0("GAD", 1:7), mpiq_columns = paste0("MPIQ", 1:8),
    support_columns = paste0("社会支持", 1:9),
    gad_input_offset = 1L, support_input_offset = 1L,
    item_missing_codes = -2,
    reported_totals = c(gad7_total = "焦虑", mpiq_total = "手机成瘾",
                        kinship_support = "亲戚", offline_friend_support = "线下", online_friend_support = "线上")
  ),
  paths = list(data = "data", results = "results"),
  bootstrap_reps = 5000L,
  network = list(chains = 4L, iter = 4000L, warmup = 2000L, cores = 4L,
                 threads_per_chain = 5L,
                 seed = 123L, adapt_delta = 0.90, max_treedepth = 10L,
                 ordinal_seed = 20260929L, ordinal_adapt_delta = 0.99,
                 ordinal_max_treedepth = 12L, ordinal_ppc_draws = 400L,
                 gaussian_ppc_draws = 1000L, ppc_seed = 2026092802L,
                 ordinal_ppc_seed = 2026093001L,
                 ordinal_ppc_engine = "inverse_cdf",
                 ordinal_ppc_engine_overrides = c(kin = "brms"),
                 pairing_seeds = c(2026093002L, 2026093003L),
                 impulse_steps = 15L, display_threshold = 0.12, display_scale = "raw"),
  gamlss_residual_replicates = 50L
)
